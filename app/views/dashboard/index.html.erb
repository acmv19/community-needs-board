
<h2 class="page-title">POSTS</h2>

<% if @posts.present? %>
<ul class="post-list">
  <% @posts.each do |post| %>
    <li class="post-card">
      <h3 class="post-title"><%= post.title %>
       <span class="post-time">• <%= time_ago_in_words(post.created_at) %> ago</span>
      </h3>
      <p  class="post-meta">By: <%= post.user.name %></p>
      <p  class="post-content"><%= post.content %></p>
    </li>
  <% end %>
<% else %>
  <p>No posts yet.</p>
<% end %>
<p class="new-post-link">
  <%= link_to "➕ New Post", new_post_path,  class: "floating-btn2" %>
</p>