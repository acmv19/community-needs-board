<h3 class="edit-comment" >Edit Comment</h3>

<%= form_with(model: [@post, @comment], local: true) do |f| %>
  <div class="form-group">
  <p class="form-label">
    <%= f.label :content %><br>
    <%= f.text_area :content %>
  </p>
  </div>
  <div class="form-actions">
  <%= f.submit " 💾 Update",  class: "btn"  %>
  <%= link_to "⬅️Back to Post", post_path(@post),  class: "btn"  %>
  </div>
<% end %>