<h1>Post Details</h1>
<h2><%= @post.title %></h2>
<p><%= @post.content %></p>
<p>Posted by: <%= @post.user.name %></p>

<% if logged_in? && current_user == @post.user %>
  <%= link_to "Edit Post", edit_post_path(@post) %> |
  <%= button_to "Delete Post", post_path(@post),
        method: :delete,
        data: { confirm: "Are you sure you want to delete this post?" },  class: "btn" %>
<% end %>

<h3>Comments</h3>
<% @post.comments.each do |comment| %>
  <div>
    <p>
      <strong><%= comment.user.name %>:</strong> <%= comment.content %>
      <% if logged_in? && comment.user == current_user %>
        | <%= link_to "Edit", edit_post_comment_path(@post, comment),  class: "btn"  %> |
        <%= button_to "Delete Comment", post_comment_path(@post, comment),
              method: :delete,
              data: { confirm: "Are you sure you want to delete this comment?" } ,  class: "btn" %>
      <% end %>
    </p>
  </div>
<% end %>

<% if logged_in? %>
  <h4>Add a comment</h4>
  <%= form_with(model: [@post, Comment.new], local: true) do |f| %>
    <p>
      <%= f.label :content %><br>
      <%= f.text_area :content %>
    </p>
    <%= f.submit "Post Comment",  class: "btn"  %>
  <% end %>
<% else %>
  <p>You must <%= link_to "log in", login_path,  class: "btn"  %> to comment.</p>
<% end %>

<p>
  <%= link_to "Back to Posts", posts_path,  class: "btn"  %>
</p>
