<h1>New Post</h1>

<%= form_with model: @post, local: true do |form| %>
  <div class="form-group">
  <div>
    <%= form.label :title, class: "form-label" %><br>
    <%= form.text_field :title, placeholder:"Title for your post" %>
  </div>

  <div>
    <%= form.label :content, class: "form-label" %><br>
    <%= form.text_area :content, placeholder:"Add your new post here" %>
  </div>

  <div class="btn-new-post">
    <%= form.submit "Create Post",  class: "btn"  %>
  </div>
  </div>
<% end %>
<div class="btn-back-posts">
<%= link_to "Back to Posts", posts_path,  class: "btn"  %>
</div>
