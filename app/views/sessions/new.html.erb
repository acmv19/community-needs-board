<h1>Login</h1>

<%= form_with url: login_path, method: :post do %>
  <p>
    <%= label_tag :email %><br>
    <%= text_field_tag :email, nil, placeholder: "your@gmail.com" %>
  </p>
  <p>
    <%= label_tag :password %><br>
    <%= password_field_tag :password, nil, placeholder: "Enter your password"  %>
  </p>
  <br>
  <p>
    <%= submit_tag "Log In",  class: "btn"  %>
  </p>
<% end %>
